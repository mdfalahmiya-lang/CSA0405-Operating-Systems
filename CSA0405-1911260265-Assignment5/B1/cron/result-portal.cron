SHELL=/bin/bash
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
# B1.2: hourly log summary and quarter-hourly disk-space alert.
0 * * * * /opt/result-portal/scripts/nginx_log_report.sh >> /var/log/result-portal/nginx_log_report.out 2>&1
*/15 * * * * /opt/result-portal/scripts/disk_alert.sh 80 / >> /var/log/result-portal/disk_alert.out 2>&1
# Rotate portal and Nginx logs daily at 02:30.
30 2 * * * /usr/sbin/logrotate /etc/logrotate.d/result-portal
